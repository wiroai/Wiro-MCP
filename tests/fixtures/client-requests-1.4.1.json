{
  "description": "Requests that WiroClient 1.4.1 sent for these inputs, recorded with Date.now returning `now` and fetch stubbed. A client without requestHeaders must send exactly these.",
  "source": {
    "package": "@wiro-ai/wiro-mcp",
    "version": "1.4.1",
    "commit": "e1d8cdf0ca8e83dd7d64eefe3d1e515b3499f0d0"
  },
  "conventions": {
    "client": "new WiroClient(apiKey, apiSecret, baseUrl) with no options. null means the argument was left out; baseUrl null is the default https://api.wiro.ai/v1.",
    "call": "post(path, body) or postForm(path, form). Each form field was appended as new Blob([text], { type }) with filename.",
    "expected": "What fetch received: the URL, init.method, init.headers exactly as passed (a plain object, key order and case kept) and a description of init.body.",
    "derived": "Not part of the request: pathname is new URL(url).pathname."
  },
  "cases": [
    {
      "id": "apikey-only/json/default-base",
      "client": {
        "apiKey": "test-api-key-0123456789abcdef",
        "apiSecret": null,
        "baseUrl": null
      },
      "requests": [
        {
          "now": 1800000000000,
          "call": {
            "method": "post",
            "path": "/Tool/List",
            "body": {}
          },
          "expected": {
            "url": "https://api.wiro.ai/v1/Tool/List",
            "method": "POST",
            "headers": {
              "x-api-key": "test-api-key-0123456789abcdef",
              "Content-Type": "application/json"
            },
            "body": {
              "type": "string",
              "value": "{}"
            }
          },
          "derived": {
            "pathname": "/v1/Tool/List"
          }
        }
      ]
    },
    {
